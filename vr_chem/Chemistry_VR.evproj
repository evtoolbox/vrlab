   <parameter name="text.line_spacing" value="0.15"/>
   <parameter name="text.value" value="Добро пожаловать в виртуальную химическую лабораторию. &#10;&#10;Для работы в лаборатории используйте контроллеры.&#10;&#10;На каждом из них есть кнопки с буквенным обозначением,&#10;джойстики, триггеры и боковые кнопки. Ознакомьтесь с &#10;расположениями кнопок на контроллерах.&#10;&#10;Для перехода между зонами лаборатории нажимайте&#10;кнопку «В» на правом контроллере. &#10;&#10;Для переключения жестов нажимайте кнопку «grip».&#10;&#10;&#10;"/>
   <view expanded="true"/>
  </reactor>
